# QKD Node — Key Management Entity (KME) per scheme_site + ETSI GS QKD 014.
# The KME remains a pure supplier of symmetric keys: no need for liboqs
# or WireGuard here (the hybrid layer lives on the SAE side). Lightweight image.
FROM python:3.12-slim

WORKDIR /app
COPY KME.py .

ENV KME_HOST=0.0.0.0
ENV KME_PORT=8000
ENV PYTHONUNBUFFERED=1

EXPOSE 8000

CMD ["python", "KME.py"]
