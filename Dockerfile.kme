# QKD Node — Key Management Entity (KME) selon scheme_site + ETSI GS QKD 014.
# Le KME reste un pur fournisseur de clés symétriques : pas besoin de liboqs
# ni de WireGuard ici (la couche hybride vit côté SAE). Image légère.
FROM python:3.12-slim

WORKDIR /app
COPY KME.py .

ENV KME_HOST=0.0.0.0
ENV KME_PORT=8000

EXPOSE 8000

CMD ["python", "KME.py"]
