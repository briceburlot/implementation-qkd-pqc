# SAE (Secure Application Entity) — orchestrates the 4 points of the img_scheme diagram.
# Requires: liboqs (PQC ML-KEM-768) + wireguard-tools/iproute2 (PSK tunnel).
FROM python:3.12-slim

# --- System dependencies: liboqs build + WireGuard tools --------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential libc6-dev \
        git cmake ninja-build gcc libssl-dev \
        wireguard-tools iproute2 iptables \
    && rm -rf /var/lib/apt/lists/*

# --- liboqs (native, shared library) ----------------------------------------
# Compiled at build time for a reproducible image (avoids runtime auto-build).
# KEM_ml_kem_768  : point 2 of the diagram (SAE<->SAE PQC key exchange)
# SIG_ml_dsa_65   : authentication of the classic SAE<->SAE channel
#                   (ML-DSA-65 / CRYSTALS-Dilithium identity certificates)
RUN git clone --depth=1 https://github.com/open-quantum-safe/liboqs /tmp/liboqs \
    && cmake -S /tmp/liboqs -B /tmp/liboqs/build \
        -GNinja -DBUILD_SHARED_LIBS=ON \
        -DOQS_MINIMAL_BUILD="KEM_ml_kem_768;SIG_ml_dsa_65" \
    && cmake --build /tmp/liboqs/build --parallel "$(nproc)" \
    && cmake --build /tmp/liboqs/build --target install \
    && rm -rf /tmp/liboqs
ENV LD_LIBRARY_PATH=/usr/local/lib:/usr/local/lib64

# --- Python liboqs wrapper + classical PKI (SAE<->KME mTLS, no PQC) --------
RUN pip install --no-cache-dir liboqs-python cryptography

ENV PYTHONUNBUFFERED=1

WORKDIR /app
COPY KME.py sae_API.py crypto_hybrid.py wireguard.py pqc_cert.py pki_setup.py ./

CMD ["python", "sae_API.py"]